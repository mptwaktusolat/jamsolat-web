---
import { PRAYER_KEYS, PRAYER_NAMES } from "../scripts/prayers";
---

<section id="prayer-list" aria-label="Waktu solat hari ini">
  <!-- skeleton cells while loading -->
  <div id="prayer-list-loading" class="prayer-grid">
    {
      Array.from({ length: 6 }).map(() => (
        <div class="prayer-cell">
          <div class="skeleton h-3 w-12 mb-2.5" />
          <div class="skeleton h-6 w-16" />
        </div>
      ))
    }
  </div>

  <div id="prayer-list-content" class="prayer-grid" hidden>
    {
      PRAYER_KEYS.map((key) => (
        <div class="prayer-cell" data-prayer-key={key}>
          <span class="prayer-name">{PRAYER_NAMES[key]}</span>
          <span class="prayer-time tabular-nums">--:--</span>
        </div>
      ))
    }
  </div>
</section>

<script>
  import { getCurrentPrayer } from "../scripts/prayers";
  import type { PrayerEntry } from "../scripts/prayers";

  function formatPrayerTime(ts: number) {
    const d = new Date(ts * 1000);
    let h = d.getHours();
    const m = String(d.getMinutes()).padStart(2, "0");
    const ampm = h >= 12 ? "PM" : "AM";
    h = h % 12 || 12;
    return `${h}:${m} ${ampm}`;
  }

  // Fill the cells and mark the prayer that is currently in effect.
  function render(prayers: PrayerEntry[], nowSec: number) {
    const loading = document.getElementById("prayer-list-loading");
    const content = document.getElementById("prayer-list-content");
    if (!loading || !content) return;

    const currentKey = getCurrentPrayer(prayers, nowSec)?.key ?? null;

    for (const prayer of prayers) {
      const cell = content.querySelector<HTMLElement>(
        `[data-prayer-key="${prayer.key}"]`,
      );
      const timeEl = cell?.querySelector(".prayer-time");
      if (!cell || !timeEl) continue;

      timeEl.textContent = formatPrayerTime(prayer.ts);
      // Syuruk is not a prayer, so it stays quiet unless it is currently active.
      cell.dataset.state =
        prayer.key === currentKey
          ? "current"
          : prayer.key === "syuruk"
            ? "muted"
            : "default";
    }

    loading.hidden = true;
    content.hidden = false;
  }

  // Keep the latest prayer data so the highlight can move after initial load.
  let lastPrayers: PrayerEntry[] | null = null;
  let lastCurrentKey: PrayerEntry["key"] | null = null;

  // Wait for the shared prayer script to send today's prayer times.
  window.addEventListener("prayerDataLoaded", (e) => {
    const { prayers, nowSec } = (e as CustomEvent).detail;
    lastPrayers = prayers;
    lastCurrentKey = getCurrentPrayer(prayers, nowSec)?.key ?? null;
    render(prayers, nowSec);
  });

  // Re-check every second so the highlight flips exactly on the prayer boundary.
  setInterval(() => {
    if (!lastPrayers) return;

    const nowSec = Math.floor(Date.now() / 1000);
    const currentKey = getCurrentPrayer(lastPrayers, nowSec)?.key ?? null;
    if (currentKey !== lastCurrentKey) {
      lastCurrentKey = currentKey;
      render(lastPrayers, nowSec);
    }
  }, 1000);
</script>
