---
import { ChevronLeft, ChevronRight, Download } from "@lucide/astro";

const COLUMNS = [
  "Hijri",
  "Imsak",
  "Subuh",
  "Syuruk",
  "Dhuha",
  "Zohor",
  "Asar",
  "Maghrib",
  "Isyak",
];
---

<section
  id="monthly-prayer-table"
  class="card"
  aria-label="Jadual waktu solat sebulan"
>
  <div class="card-head">
    <div>
      <div class="card-title">Jadual waktu solat sebulan</div>
    </div>

    <div class="card-actions">
      <button type="button" id="month-prev" class="pill-btn">
        <ChevronLeft size={14} aria-hidden="true" />
        Sebelum
      </button>
      <span id="month-current-label" class="pill-label">—</span>
      <button type="button" id="month-next" class="pill-btn">
        Seterusnya
        <ChevronRight size={14} aria-hidden="true" />
      </button>
      <button type="button" id="month-print" class="pill-btn">
        <Download size={14} aria-hidden="true" />
        <span id="month-print-label">PDF</span>
      </button>
    </div>
  </div>

  <div
    id="month-table-error"
    class="hidden px-6 py-4 text-sm text-red-600"
    role="status"
  >
  </div>

  <div id="month-table-loading" class="p-6 space-y-2">
    <div class="skeleton h-9 w-full"></div>
    <div class="skeleton h-9 w-full"></div>
    <div class="skeleton h-9 w-full"></div>
    <div class="skeleton h-9 w-full"></div>
  </div>

  <div id="month-table-wrap" class="hidden overflow-x-auto">
    <table class="w-full min-w-275 table-fixed border-collapse text-sm">
      <thead>
        <tr class="bg-surface-soft text-ink-muted">
          <th
            class="w-32 text-center align-middle px-3 py-2.5 font-medium whitespace-nowrap"
            >Tarikh</th
          >
          <th
            class="w-16 text-center align-middle px-3 py-2.5 font-medium whitespace-nowrap"
            >Hari</th
          >
          {
            COLUMNS.map((label) => (
              <th class="text-center align-middle px-3 py-2.5 font-medium">
                {label}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody id="month-table-body"></tbody>
    </table>
  </div>
</section>

<script>
  import {
    fetchPrayerTimes,
    fetchMonthlyTimetablePDF,
    type V2Response,
  } from "../scripts/api";
  import { formatHijriDate } from "../scripts/hijri";

  const TIME_KEYS = [
    "imsak",
    "fajr",
    "syuruk",
    "dhuha",
    "dhuhr",
    "asr",
    "maghrib",
    "isha",
  ] as const;

  // The month currently on screen — the arrows page away from today's month.
  let zone: string | null = null;
  let viewYear = 0;
  let viewMonth = 0;
  let requestId = 0;

  function format24(tsSec: number): string {
    const d = new Date(tsSec * 1000);
    const h = String(d.getHours()).padStart(2, "0");
    const m = String(d.getMinutes()).padStart(2, "0");
    return `${h}:${m}`;
  }

  function formatShortDate(day: number, month: number, year: number) {
    const date = new Date(year, month - 1, day);
    return date.toLocaleDateString("en-GB", {
      day: "2-digit",
      month: "short",
      year: "2-digit",
    });
  }

  function formatShortDay(day: number, month: number, year: number) {
    const date = new Date(year, month - 1, day);
    return date.toLocaleDateString("en-GB", { weekday: "short" });
  }

  function highlightDay(year: number, month: number): number {
    const now = new Date();
    return now.getFullYear() === year && now.getMonth() + 1 === month
      ? now.getDate()
      : -1;
  }

  function setNavDisabled(disabled: boolean) {
    for (const id of ["month-prev", "month-next"]) {
      const btn = document.getElementById(id) as HTMLButtonElement | null;
      if (btn) btn.disabled = disabled;
    }
  }

  function showError(message: string) {
    const errEl = document.getElementById("month-table-error");
    if (!errEl) return;
    errEl.textContent = message;
    errEl.classList.toggle("hidden", message === "");
  }

  function renderMonthTable(monthly: V2Response, currentDay: number) {
    const labelEl = document.getElementById("month-current-label");
    const body = document.getElementById("month-table-body");
    const loading = document.getElementById("month-table-loading");
    const wrap = document.getElementById("month-table-wrap");

    if (!labelEl || !body || !loading || !wrap) return;

    showError("");
    labelEl.textContent = `${monthly.month} ${monthly.year}`;
    body.innerHTML = "";

    for (const p of monthly.prayers) {
      const row = document.createElement("tr");
      row.className = "month-row";
      if (p.day === currentDay) row.classList.add("month-row-active");

      const dateCell = document.createElement("td");
      dateCell.className = "text-center align-middle px-3 py-2.5 tabular-nums";
      dateCell.textContent = formatShortDate(
        p.day,
        monthly.month_number,
        monthly.year,
      );
      row.appendChild(dateCell);

      const weekdayCell = document.createElement("td");
      weekdayCell.className = "w-16 text-center align-middle px-3 py-2.5";
      weekdayCell.textContent = formatShortDay(
        p.day,
        monthly.month_number,
        monthly.year,
      );
      row.appendChild(weekdayCell);

      const hijriCell = document.createElement("td");
      hijriCell.className = "text-center align-middle px-3 py-2.5";
      hijriCell.textContent = formatHijriDate(p.hijri, "short");
      row.appendChild(hijriCell);

      for (const key of TIME_KEYS) {
        const cell = document.createElement("td");
        cell.className = "text-center align-middle px-3 py-2.5 tabular-nums";
        cell.textContent = format24(p[key]);
        row.appendChild(cell);
      }

      body.appendChild(row);
    }

    loading.classList.add("hidden");
    wrap.classList.remove("hidden");
    setNavDisabled(false);
  }

  async function showMonth(year: number, month: number) {
    if (!zone) return;

    const id = ++requestId;
    setNavDisabled(true);

    let data: V2Response;
    try {
      data = await fetchPrayerTimes(zone, year, month);
    } catch {
      if (id !== requestId) return;
      showError("Gagal memuat jadual bulan ini. Sila cuba lagi.");
      setNavDisabled(false);
      return;
    }

    if (id !== requestId) return;
    viewYear = year;
    viewMonth = month;
    renderMonthTable(data, highlightDay(year, month));
  }

  function shiftMonth(offset: number) {
    let month = viewMonth + offset;
    let year = viewYear;
    if (month < 1) {
      month = 12;
      year -= 1;
    } else if (month > 12) {
      month = 1;
      year += 1;
    }
    void showMonth(year, month);
  }

  document
    .getElementById("month-prev")
    ?.addEventListener("click", () => shiftMonth(-1));
  document
    .getElementById("month-next")
    ?.addEventListener("click", () => shiftMonth(1));
  async function downloadMonthlyPDF() {
    if (!zone) return;

    const btn = document.getElementById(
      "month-print",
    ) as HTMLButtonElement | null;
    const label = document.getElementById("month-print-label");
    if (!btn || !label) return;

    const originalLabel = label.textContent;
    btn.disabled = true;
    label.textContent = "Memuat turun…";

    try {
      const blob = await fetchMonthlyTimetablePDF(zone, viewYear, viewMonth);
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = `jadual-solat-${zone}-${viewYear}-${String(viewMonth).padStart(2, "0")}.pdf`;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    } catch {
      showError("Gagal memuat turun PDF. Sila cuba lagi.");
    } finally {
      btn.disabled = false;
      label.textContent = originalLabel;
    }
  }

  document
    .getElementById("month-print")
    ?.addEventListener("click", () => void downloadMonthlyPDF());

  // A fresh load (or a zone change) always snaps the table back to today.
  window.addEventListener("prayerDataLoaded", (e) => {
    const { monthly, day } = (e as CustomEvent).detail as {
      monthly?: V2Response;
      day?: number;
    };
    if (!monthly || !day) return;

    requestId++;
    zone = monthly.zone;
    viewYear = monthly.year;
    viewMonth = monthly.month_number;
    renderMonthTable(monthly, day);
  });
</script>
