---
import Layout from "../layouts/Layout.astro";
import PrayerList from "../components/PrayerList.astro";
import MonthlyPrayerTable from "../components/MonthlyPrayerTable.astro";
import Footer from "../components/Footer.astro";
import { ArrowDown, ChevronDown, LocateFixed } from "@lucide/astro";
---

<Layout>
  <main>
    <!-- Error state -->
    <div
      id="page-error"
      class="hidden px-6 py-3 bg-red-600 text-white font-semibold text-sm tracking-wide text-center"
    >
    </div>

    <h1 class="sr-only">Waktu solat Malaysia hari ini mengikut zon JAKIM</h1>

    <section class="hero">
      <div class="hero-inner">
        <div class="flex justify-end">
          <div class="loc-pill">
            <button
              type="button"
              id="change-location"
              class="loc-zone"
              aria-label="Tukar zon solat"
            >
              <span id="zone-display">Memuat zon...</span>
              <ChevronDown size={14} class="loc-caret" aria-hidden="true" />
            </button>
            <span class="loc-divider" aria-hidden="true"></span>
            <button
              type="button"
              id="use-current-location"
              class="loc-gps"
              title="Guna lokasi semasa"
              aria-label="Guna lokasi semasa"
            >
              <LocateFixed size={15} aria-hidden="true" />
            </button>
            <select
              id="zone-select"
              class="zone-hidden-select"
              aria-label="Pilih zon solat"
              tabindex="-1"
            >
              <option value="">Memuat zon...</option>
            </select>
          </div>
        </div>

        <!-- Next prayer -->
        <div class="hero-main">
          <div>
            <div class="hero-next-line" aria-live="polite">
              <span id="next-prayer-name" class="hero-next-name">&mdash;</span>
              <span id="next-prayer-time" class="hero-next-time">--:--</span>
            </div>
            <div id="next-prayer-countdown" class="hero-countdown">
              Memuat waktu solat&hellip;
            </div>
          </div>

          <div class="hero-date">
            <div id="live-date" class="hero-date-greg">N/A</div>
            <div id="live-hijri" class="hero-date-hijri"></div>
          </div>
        </div>

        <!-- Today at a glance -->
        <div>
          <div
            class="hero-progress"
            role="progressbar"
            aria-label="Baki masa sebelum waktu solat seterusnya"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            id="hero-progress"
          >
            <div id="hero-progress-fill" class="hero-progress-fill"></div>
          </div>

          <h2 class="sr-only">Waktu solat hari ini</h2>
          <PrayerList />

          <div class="hero-foot">
            <a href="#monthly-timetable" class="hero-foot-link">
              <ArrowDown size={14} aria-hidden="true" />
              Lihat jadual sebulan di bawah
            </a>
            <span id="hero-status" class="hero-foot-status"></span>
          </div>
        </div>
      </div>
    </section>

    <section id="monthly-timetable" class="max-w-7xl mx-auto px-6 py-8">
      <h2 class="sr-only">Jadual waktu solat bulanan Malaysia</h2>
      <MonthlyPrayerTable />
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import {
    fetchPrayerTimes,
    fetchPrayerTimesByGPS,
    fetchAllZones,
  } from "../scripts/api";
  import { formatHijriDate } from "../scripts/hijri";
  import {
    formatCountdownLong,
    getCountdownColor,
    getCountdownSeconds,
    getCurrentPrayer,
    getNextPrayer,
    getPrayerTimeRemaining,
    getPrayersForDay,
  } from "../scripts/prayers";
  import type { V2Response, ZoneInfo } from "../scripts/api";
  import type { PrayerEntry } from "../scripts/prayers";

  const DEFAULT_ZONE = "WLY01";

  // State
  let currentZone = DEFAULT_ZONE;
  let monthlyData: V2Response | null = null;
  let currentPrayers: PrayerEntry[] = [];
  let lastLoadedDayKey: string | null = null;
  let rolloverTimer: number | null = null;
  let tomorrowFirstPrayer: PrayerEntry | null = null;
  let tomorrowFirstPrayerKey: string | null = null;
  let tomorrowFirstPrayerRequestKey: string | null = null;
  let tomorrowFirstPrayerFailures = 0;
  let tomorrowFirstPrayerRetryAt = 0;

  // The lookup for tomorrow runs off the one-second countdown tick, so a failed
  // attempt has to back off — otherwise a network blip after Isyak turns into
  // one request per second for the rest of the night.
  const TOMORROW_RETRY_BASE_MS = 5_000;
  const TOMORROW_RETRY_MAX_MS = 5 * 60_000;

  const gregorianFormatter = new Intl.DateTimeFormat("ms-MY", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });

  function getHijriDate(now: Date): string | null {
    if (!monthlyData) return null;
    if (
      monthlyData.year !== now.getFullYear() ||
      monthlyData.month_number !== now.getMonth() + 1
    ) {
      return null;
    }

    return (
      monthlyData.prayers.find((p) => p.day === now.getDate())?.hijri ?? null
    );
  }

  function getDayKey(d: Date): string {
    return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
  }

  async function refreshIfDayChanged() {
    const todayKey = getDayKey(new Date());
    if (todayKey === lastLoadedDayKey) return;
    await loadData();
  }

  function scheduleNextDayRollover() {
    if (rolloverTimer !== null) window.clearTimeout(rolloverTimer);

    const now = new Date();
    const nextMidnight = new Date(
      now.getFullYear(),
      now.getMonth(),
      now.getDate() + 1,
      0,
      0,
      1,
      0,
    );
    const delayMs = Math.max(1000, nextMidnight.getTime() - now.getTime());

    rolloverTimer = window.setTimeout(async () => {
      await refreshIfDayChanged();
      scheduleNextDayRollover();
    }, delayMs);
  }

  function updateDate() {
    const now = new Date();
    const dateEl = document.getElementById("live-date");
    const hijriEl = document.getElementById("live-hijri");
    if (dateEl) dateEl.textContent = gregorianFormatter.format(now);

    if (hijriEl) {
      const hijriDate = getHijriDate(now);
      hijriEl.textContent = hijriDate
        ? formatHijriDate(hijriDate, { padDay: false, yearSuffix: "H" })
        : "";
    }
  }

  function setStatus(text: string) {
    const el = document.getElementById("hero-status");
    if (el) el.textContent = text;
  }

  function format24(tsSec: number): string {
    const d = new Date(tsSec * 1000);
    return `${String(d.getHours()).padStart(2, "0")}:${String(
      d.getMinutes(),
    ).padStart(2, "0")}`;
  }

  function getTomorrow(from: Date): Date {
    return new Date(from.getFullYear(), from.getMonth(), from.getDate() + 1);
  }

  function formatPrayerTime(prayer: PrayerEntry): string {
    const d = new Date(prayer.ts * 1000);
    let h = d.getHours();
    const m = String(d.getMinutes()).padStart(2, "0");
    const ampm = h >= 12 ? "PM" : "AM";
    h = h % 12 || 12;
    return `${h}:${m} ${ampm}`;
  }

  function clearTomorrowFirstPrayer() {
    tomorrowFirstPrayer = null;
    tomorrowFirstPrayerKey = null;
    tomorrowFirstPrayerRequestKey = null;
    tomorrowFirstPrayerFailures = 0;
    tomorrowFirstPrayerRetryAt = 0;
  }

  function scheduleTomorrowRetry() {
    tomorrowFirstPrayerFailures += 1;
    const delay = Math.min(
      TOMORROW_RETRY_MAX_MS,
      TOMORROW_RETRY_BASE_MS * 2 ** (tomorrowFirstPrayerFailures - 1),
    );
    tomorrowFirstPrayerRetryAt = Date.now() + delay;
  }

  // An empty colour falls back to the accent defined in the stylesheet.
  function renderProgress(percent: number, color = "") {
    const track = document.getElementById("hero-progress");
    const fill = document.getElementById("hero-progress-fill");
    if (!track || !fill) return;
    fill.style.width = `${percent.toFixed(1)}%`;
    fill.style.backgroundColor = color;
    track.setAttribute("aria-valuenow", String(Math.round(percent)));
  }

  function renderNextPrayer(prayer: PrayerEntry | null, nowSec: number) {
    const nameEl = document.getElementById("next-prayer-name");
    const timeEl = document.getElementById("next-prayer-time");
    const countdownEl = document.getElementById("next-prayer-countdown");

    if (!nameEl || !timeEl || !countdownEl) return;

    if (!prayer) {
      nameEl.textContent = "—";
      timeEl.textContent = "--:--";
      countdownEl.textContent = "Memuat waktu solat…";
      countdownEl.style.color = "";
      renderProgress(0);
      return;
    }

    const isTomorrow = prayer === tomorrowFirstPrayer;
    const secondsLeft = getCountdownSeconds(prayer, nowSec);
    const urgencyColor = getCountdownColor(secondsLeft);

    nameEl.textContent = prayer.name;
    timeEl.textContent = formatPrayerTime(prayer);
    countdownEl.textContent = isTomorrow
      ? `dalam ${formatCountdownLong(secondsLeft)} · esok`
      : `dalam ${formatCountdownLong(secondsLeft)}`;
    countdownEl.style.color = urgencyColor;

    const prevPrayer = getCurrentPrayer(currentPrayers, nowSec);
    renderProgress(
      getPrayerTimeRemaining(prevPrayer?.ts ?? null, prayer.ts, nowSec),
      urgencyColor,
    );
  }

  async function ensureTomorrowFirstPrayer(now: Date) {
    const tomorrow = getTomorrow(now);
    const tomorrowKey = `${currentZone}-${getDayKey(tomorrow)}`;

    if (tomorrowFirstPrayerKey === tomorrowKey) return;
    if (tomorrowFirstPrayerRequestKey === tomorrowKey) return;
    if (Date.now() < tomorrowFirstPrayerRetryAt) return;

    tomorrowFirstPrayerRequestKey = tomorrowKey;
    const zoneAtRequest = currentZone;
    const dayKeyAtRequest = getDayKey(tomorrow);

    try {
      const data =
        monthlyData?.zone === zoneAtRequest &&
        monthlyData.year === tomorrow.getFullYear() &&
        monthlyData.month_number === tomorrow.getMonth() + 1
          ? monthlyData
          : await fetchPrayerTimes(
              zoneAtRequest,
              tomorrow.getFullYear(),
              tomorrow.getMonth() + 1,
            );
      const prayers = getPrayersForDay(data, tomorrow.getDate());
      const firstPrayer = prayers[0] ?? null;

      if (
        currentZone !== zoneAtRequest ||
        dayKeyAtRequest !== getDayKey(getTomorrow(new Date()))
      ) {
        return;
      }

      if (!firstPrayer) {
        scheduleTomorrowRetry();
        return;
      }

      tomorrowFirstPrayer = firstPrayer;
      tomorrowFirstPrayerKey = tomorrowKey;
      tomorrowFirstPrayerFailures = 0;
      tomorrowFirstPrayerRetryAt = 0;
      updateNextPrayerCountdown();
    } catch {
      // Keep the loading state; the backoff decides when to retry.
      scheduleTomorrowRetry();
    } finally {
      if (tomorrowFirstPrayerRequestKey === tomorrowKey) {
        tomorrowFirstPrayerRequestKey = null;
      }
    }
  }

  function updateNextPrayerCountdown() {
    const now = new Date();
    const nowSec = Math.floor(now.getTime() / 1000);
    const nextPrayer = getNextPrayer(currentPrayers, nowSec);

    if (nextPrayer) {
      renderNextPrayer(nextPrayer, nowSec);
      return;
    }

    renderNextPrayer(tomorrowFirstPrayer, nowSec);
    void ensureTomorrowFirstPrayer(now);
  }

  // URL helpers
  function readURLParams() {
    const params = new URLSearchParams(window.location.search);
    const loc = params.get("location");
    if (loc) currentZone = loc.toUpperCase();
  }

  function pushURL() {
    const url = new URL(window.location.href);
    url.searchParams.set("location", currentZone);
    history.pushState({}, "", url);
  }

  // Publish freshly loaded data to the prayer grid and the monthly table.
  function publishPrayerData(data: V2Response, today: Date) {
    const day = today.getDate();
    const prayers = getPrayersForDay(data, day);
    const nowSec = Math.floor(Date.now() / 1000);

    currentPrayers = prayers;
    clearTomorrowFirstPrayer();

    window.dispatchEvent(
      new CustomEvent("prayerDataLoaded", {
        detail: { prayers, nowSec, zone: currentZone, monthly: data, day },
      }),
    );

    lastLoadedDayKey = getDayKey(today);
    const imsak = data.prayers.find((p) => p.day === day)?.imsak;
    setStatus(imsak ? `Imsak ${format24(imsak)}` : "");
    updateDate();
    updateNextPrayerCountdown();
  }

  // Data fetching
  async function loadData() {
    const today = new Date();
    setStatus("Memuat data JAKIM…");

    try {
      monthlyData = await fetchPrayerTimes(
        currentZone,
        today.getFullYear(),
        today.getMonth() + 1,
      );
    } catch {
      const errEl = document.getElementById("page-error");
      if (errEl) {
        errEl.textContent =
          "Gagal memuat waktu solat. Sila semak sambungan internet anda.";
        errEl.classList.remove("hidden");
      }
      setStatus("Gagal muat data JAKIM");
      return;
    }

    publishPrayerData(monthlyData, today);
  }

  // Geolocation
  function tryGeolocation(options: { fallbackToDefault?: boolean } = {}) {
    const fallbackToDefault = options.fallbackToDefault ?? true;
    const gpsButton = document.getElementById("use-current-location");

    if (!("geolocation" in navigator)) {
      if (fallbackToDefault) {
        resolveZone(DEFAULT_ZONE);
        void loadData();
      }
      return;
    }

    gpsButton?.setAttribute("data-active", "true");
    navigator.geolocation.getCurrentPosition(
      async (pos) => {
        const { latitude, longitude } = pos.coords;
        try {
          const today = new Date();
          const gpsData = await fetchPrayerTimesByGPS(
            latitude,
            longitude,
            today.getFullYear(),
            today.getMonth() + 1,
          );
          currentZone = gpsData.zone;
          monthlyData = gpsData;
          resolveZone(currentZone);
          publishPrayerData(gpsData, today);
          pushURL();
        } catch {
          if (fallbackToDefault) {
            resolveZone(DEFAULT_ZONE);
            await loadData();
          }
        } finally {
          gpsButton?.removeAttribute("data-active");
        }
      },
      () => {
        // Permission denied or error
        gpsButton?.removeAttribute("data-active");
        if (fallbackToDefault) {
          resolveZone(DEFAULT_ZONE);
          void loadData();
        }
      },
      { timeout: 8000 },
    );
  }

  function resolveZone(zone: string) {
    currentZone = zone;
    window.dispatchEvent(new CustomEvent("zoneResolved", { detail: { zone } }));
  }

  // Zone selector
  async function populateZones(selectedZone: string) {
    const select = document.getElementById(
      "zone-select",
    ) as HTMLSelectElement | null;
    if (!select) return;

    let zones: ZoneInfo[];
    try {
      zones = await fetchAllZones();
    } catch {
      select.innerHTML = `<option value="${selectedZone}">${selectedZone}</option>`;
      updateZoneDisplay();
      return;
    }

    const byState = new Map<string, ZoneInfo[]>();
    for (const z of zones) {
      if (!byState.has(z.negeri)) byState.set(z.negeri, []);
      byState.get(z.negeri)!.push(z);
    }

    select.innerHTML = "";
    for (const [state, zoneList] of byState) {
      const group = document.createElement("optgroup");
      group.label = state;

      for (const z of zoneList) {
        const opt = document.createElement("option");
        opt.value = z.jakimCode;
        opt.textContent = `${z.jakimCode} · ${z.daerah}`;
        if (z.jakimCode === selectedZone) opt.selected = true;
        group.appendChild(opt);
      }

      select.appendChild(group);
    }

    updateZoneDisplay();
  }

  function updateZoneDisplay() {
    const select = document.getElementById(
      "zone-select",
    ) as HTMLSelectElement | null;
    const display = document.getElementById("zone-display");
    if (!select || !display) return;

    display.textContent =
      select.selectedOptions[0]?.textContent?.trim() ||
      select.value ||
      "Pilih zon";
  }

  // Event handlers
  document.getElementById("zone-select")?.addEventListener("change", (e) => {
    const zone = (e.target as HTMLSelectElement).value;
    updateZoneDisplay();
    window.dispatchEvent(new CustomEvent("zoneChanged", { detail: { zone } }));
  });

  document.getElementById("change-location")?.addEventListener("click", () => {
    const select = document.getElementById(
      "zone-select",
    ) as HTMLSelectElement | null;
    if (!select) return;

    const picker = (select as HTMLSelectElement & { showPicker?: () => void })
      .showPicker;
    if (picker) {
      try {
        picker.call(select);
        return;
      } catch {}
    }

    select.focus();
    select.click();
  });

  document
    .getElementById("use-current-location")
    ?.addEventListener("click", () => {
      tryGeolocation({ fallbackToDefault: false });
    });

  window.addEventListener("zoneResolved", async (e) => {
    const { zone } = (e as CustomEvent).detail;
    await populateZones(zone);
    const select = document.getElementById(
      "zone-select",
    ) as HTMLSelectElement | null;
    if (select) {
      select.value = zone;
      updateZoneDisplay();
    }
  });

  window.addEventListener("zoneChanged", async (e) => {
    const { zone } = (e as CustomEvent).detail;
    currentZone = zone;
    monthlyData = null;
    currentPrayers = [];
    clearTomorrowFirstPrayer();
    updateNextPrayerCountdown();
    pushURL();
    window.dispatchEvent(new CustomEvent("zoneResolved", { detail: { zone } }));
    await loadData();
  });

  // popstate (browser back/forward)
  window.addEventListener("popstate", () => {
    readURLParams();
    resolveZone(currentZone);
    void loadData();
  });

  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState !== "visible") return;
    void refreshIfDayChanged();
  });

  window.addEventListener("focus", () => {
    void refreshIfDayChanged();
  });

  // Bootstrap
  updateDate();
  updateNextPrayerCountdown();
  setInterval(() => {
    updateDate();
    updateNextPrayerCountdown();
  }, 1000);
  readURLParams();
  scheduleNextDayRollover();

  if (new URLSearchParams(window.location.search).has("location")) {
    // use currentZone from URL, skip geolocation
    resolveZone(currentZone);
    loadData();
  } else {
    // Try geolocation first
    resolveZone(DEFAULT_ZONE); // immediately show WLY01 while we wait
    loadData();
    tryGeolocation();
  }
</script>
